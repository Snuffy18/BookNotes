# Copy to .env and fill in. Never commit .env.
#
# The OpenAI key is NOT used by the app. It lives only in the Supabase Edge
# Function secret:
#   npx supabase secrets set OPENAI_API_KEY=sk-...

# Supabase project hosting the openai-responses Edge Function.
# Find these in: Supabase Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional model overrides.
# EXPO_PUBLIC_OPENAI_IMAGE_MODEL=gpt-4o-mini
# EXPO_PUBLIC_OPENAI_PAGE_MODEL=gpt-4.1-mini
